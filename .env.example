# Docker Registry Config (Align with other projects)
ACR_REGISTRY=
ACR_NAMESPACE=
IMAGE_NAME=docker-venv
IMAGE_TAG=main

# Container Runtime Config
TZ=Asia/Shanghai
LANG=C.UTF-8

# 需与镜像构建时的 dev_user/dev_uid/dev_gid 一致（默认值即 CI 矩阵的常用取值）
DEV_USER=dev
DEV_UID=1000
DEV_GID=1000

# Resource Limits (0 = unlimited)
CPUS=0
MEM_LIMIT=0
