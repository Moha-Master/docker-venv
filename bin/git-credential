#!/bin/bash

SUBCOMMAND="$1"
RAW_INPUT=$(cat /dev/stdin)

extract_orig_host() {
    local insteadOf="$1"
    local without_protocol="${insteadOf#https://}"
    without_protocol="${without_protocol#http://}"
    if [[ "$without_protocol" == *"/"* ]]; then
        echo "${without_protocol%%/*}"
    else
        echo "$without_protocol"
    fi
}

is_protocol_prefix() {
    local insteadOf="$1"
    local without_protocol="${insteadOf#https://}"
    without_protocol="${without_protocol#http://}"
    [[ "$without_protocol" =~ ^[^/]*\..* ]] && return 1
    return 0
}

process_rule() {
    local url_value="$1"
    local insteadOf="$2"
    
    if is_protocol_prefix "$insteadOf"; then
        local proxy_host="${url_value#https://}"
        proxy_host="${proxy_host#http://}"
        proxy_host="${proxy_host%%/*}"
        echo "PROTOCOL_REPLACE|$proxy_host|github.com|$url_value"
    else
        local orig_host=$(extract_orig_host "$insteadOf")
        
        [[ "$orig_host" != "github.com" ]] && [[ "$orig_host" != *"github"* ]] && return
        
        if [[ "$url_value" == *"${insteadOf}"* ]]; then
            local proxy_host="${url_value#https://}"
            proxy_host="${proxy_host#http://}"
            proxy_host="${proxy_host%%/*}"
            echo "PREFIX_INSERT|$proxy_host|$orig_host|$url_value"
        else
            local mirror_host="${url_value#https://}"
            mirror_host="${mirror_host#http://}"
            echo "HOST_REPLACE|$mirror_host|$orig_host|$url_value"
        fi
    fi
}

get_proxy_host_from_prefix() {
    local prefix="$1"
    local result="${prefix#https://}"
    result="${result#http://}"
    echo "${result%%/*}"
}

parse_insteadof_rules() {
    local in_url_block=false
    local url_value=""
    local insteadof_value=""

    process_file() {
        local file="$1"
        [ -f "$file" ] || return
        
        while IFS= read -r line || [ -n "$line" ]; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue

            if [[ "$line" =~ ^\[url\ +\"(.+)\"\] ]]; then
                if $in_url_block && [ -n "$url_value" ] && [ -n "$insteadof_value" ]; then
                    process_rule "$url_value" "$insteadof_value"
                fi
                in_url_block=true
                url_value="${BASH_REMATCH[1]}"
                insteadof_value=""
                continue
            fi

            if [[ "$line" =~ ^\[.+\] ]]; then
                if $in_url_block && [ -n "$url_value" ] && [ -n "$insteadof_value" ]; then
                    process_rule "$url_value" "$insteadof_value"
                fi
                in_url_block=false
                url_value=""
                insteadof_value=""
                continue
            fi

            if $in_url_block; then
                if [[ "$line" =~ ^[[:space:]]+insteadOf[[:space:]]*=(.+) ]]; then
                    insteadof_value="${BASH_REMATCH[1]}"
                    insteadof_value=$(echo "$insteadof_value" | xargs)
                fi
            fi
        done < "$file"
    }

    process_file "/etc/gitconfig"
    process_file "$HOME/.gitconfig"
    [ -n "$XDG_CONFIG_HOME" ] && process_file "$XDG_CONFIG_HOME/git/gitconfig"

    if $in_url_block && [ -n "$url_value" ] && [ -n "$insteadof_value" ]; then
        process_rule "$url_value" "$insteadof_value"
    fi
}

RULES=$(parse_insteadof_rules)
CURRENT_HOST=$(echo "$RAW_INPUT" | grep -E '^host=' | head -1 | cut -d'=' -f2)

MODE=""
ORIG_HOST=""
MIRROR_PREFIX=""

while IFS= read -r rule; do
    [ -z "$rule" ] && continue
    
    m="${rule%%|*}"
    rest="${rule#*|}"
    h="${rest%%|*}"
    rest="${rest#*|}"
    o="${rest%%|*}"
    p="${rest#*|}"
    
    if [ "$CURRENT_HOST" = "$h" ]; then
        MODE="$m"
        ORIG_HOST="$o"
        MIRROR_PREFIX="$p"
        break
    fi
done <<< "$RULES"

case "$SUBCOMMAND" in
    get|store|erase)
        if [ -n "$MODE" ]; then
            PROXY_HOST=$(get_proxy_host_from_prefix "$MIRROR_PREFIX")
            MODIFIED_INPUT=$(echo "$RAW_INPUT" | sed "s/^host=${PROXY_HOST}\$/host=${ORIG_HOST}/")
            
            RESULT=$(echo "$MODIFIED_INPUT" | /usr/bin/gh auth git-credential "$SUBCOMMAND")
            
            if [ -n "$RESULT" ]; then
                echo "$RESULT" | sed "s/^host=${ORIG_HOST}\$/host=${PROXY_HOST}/"
            fi
        else
            echo "$RAW_INPUT" | /usr/bin/gh auth git-credential "$SUBCOMMAND"
        fi
        ;;
    *)
        echo "$RAW_INPUT" | /usr/bin/gh auth git-credential "$SUBCOMMAND"
        ;;
esac
